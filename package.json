{
  "name": "giurom-backend",
  "version": "1.0.0",
  "description": "Giurom Backend - Punct de Lucru si Adaugare Firma",
  "author": "Giurom Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:libs:tenant-access": "jest --config libs/tenant-access/jest.config.js",
    "build:libs:tenant-access": "tsc -p libs/tenant-access/tsconfig.json",
    "start:ms:employees": "ts-node -r tsconfig-paths/register -P employees/tsconfig.json employees/src/main.ts",
    "start:ms:company": "ts-node -r tsconfig-paths/register -P company/tsconfig.json company/src/main.ts",
    "start:ms:locations": "ts-node -r tsconfig-paths/register -P locations/tsconfig.json locations/src/main.ts",
    "start:ms:stock": "ts-node -r tsconfig-paths/register -P stock/tsconfig.json stock/src/main.ts",
    "start:ms:recipes": "ts-node -r tsconfig-paths/register -P recipes/tsconfig.json recipes/src/main.ts",
    "start:ms:calendar": "ts-node -r tsconfig-paths/register -P calendar-ms/tsconfig.json calendar-ms/src/main.ts",
    "start:ms:attendance": "ts-node -r tsconfig-paths/register -P attendance-ms/tsconfig.json attendance-ms/src/main.ts",
    "start:ms:suppliers": "ts-node -r tsconfig-paths/register -P suppliers-ms/tsconfig.json suppliers-ms/src/main.ts",
    "start:ms:waste": "cd waste-records-ms && ts-node -r tsconfig-paths/register src/main.ts",
    "start:ms:requests": "ts-node -r tsconfig-paths/register -P requests-ms/tsconfig.json requests-ms/src/main.ts",
    "start:ms:notifications": "ts-node -r tsconfig-paths/register -P notifications-ms/tsconfig.json notifications-ms/src/main.ts",
    "start:ms:tasks": "cd veziv-tasks && npx tsc -p tsconfig.build.json --incremental false && node dist/main.js",
    "start:gateway": "node api-gateway/src/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^10.4.20",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/typeorm": "^10.0.1",
    "body-parser": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "mariadb": "^3.2.3",
    "mysql2": "^3.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.19",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
