DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=giurom_notifications
DB_SYNCHRONIZE=true
DB_LOGGING=false

PORT=3020
NODE_ENV=development
JWT_SECRET=your-secret-key

# API Gateway (pentru user resolution, roluri manager/admin)
API_GATEWAY_URL=http://localhost:3002

# Secret pentru request-uri interne (trebuie identic cu locations, api-gateway, etc. – altfel getLocationName dă 401)
SERVICE_SECRET=veziv-internal-secret

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
NOTIFICATIONS_QUEUE=notifications

# Web Push (FCM) – pune una dintre variabile:
# FIREBASE_SERVICE_ACCOUNT_PATH=cale/catre/fisier-service-account.json
# sau FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=

# URL frontend (pentru link-uri în notificările push)
FRONTEND_BASE_URL=https://giurom.bitap.ro

# FCM: calea către fișierul JSON descărcat din Firebase (Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./giurom-web-notifications-firebase-adminsdk-fbsvc-a54201879c.json