# Configurația aplicației
NODE_ENV=development
PORT=3007

# Frontend URL pentru CORS
FRONTEND_URL=http://localhost:3000


DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=giurom_db
DB_SYNCHRONIZE=true
# Configurații de securitate (opționale - pentru dezvoltare ulterioară)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_REFRESH_EXPIRATION=7d

# Configurația pentru rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Configurația pentru uploaduri
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760 